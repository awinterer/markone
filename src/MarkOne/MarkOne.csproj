<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MarkOne</AssemblyName>
    <RootNamespace>MarkOne</RootNamespace>
    <ApplicationTitle>MarkOne</ApplicationTitle>
    <ApplicationIcon>../../assets/icon/markone.ico</ApplicationIcon>
    <Version>0.3.0</Version>
    <SelfContained>false</SelfContained>
    <!-- Nur 64-Bit-Windows: so landet genau eine pdfium.dll neben der EXE statt drei. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Speicherzügel. Auf einer 20-Kern-Maschine reserviert der GC sonst
    großzügig Arbeitsspeicher, den ein Texteditor nie braucht.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
    <TieredCompilationQuickJitForLoops>true</TieredCompilationQuickJitForLoops>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <!-- PDF-Kern von Chrome als fertige Bibliothek, angesprochen über Pdfium.cs. -->
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="152.0.7961" />
  </ItemGroup>

</Project>
