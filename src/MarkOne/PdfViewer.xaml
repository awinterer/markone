<UserControl x:Class="MarkOne.PdfViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             Background="{DynamicResource Brush.ViewerBg}"
             PreviewKeyDown="OnKeyDown">

    <Grid>
        <ScrollViewer x:Name="Scroller" AutomationProperties.Name="PDF-Seiten"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="Transparent" Focusable="False"
                      ScrollChanged="OnScrollChanged"
                      PreviewMouseWheel="OnWheel"
                      PreviewMouseLeftButtonDown="OnClick">
            <StackPanel x:Name="Pages" HorizontalAlignment="Center" Margin="24,20" />
        </ScrollViewer>

        <TextBlock x:Name="Message" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Ui}" FontSize="13"
                   Foreground="{DynamicResource Brush.Muted}"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
