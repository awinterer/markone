<Window x:Class="MarkOne.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MarkOne"
        Title="MarkOne" Height="880" Width="1240"
        MinHeight="360" MinWidth="620"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Background="#F1EEE8">

    <Window.Resources>

        <Style x:Key="Chrome" TargetType="Menu">
            <Setter Property="Background" Value="#F1EEE8" />
            <Setter Property="Foreground" Value="#4A473F" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Flache Werkzeugleisten-Schaltfläche ohne 3D-Rahmen -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#3B382F" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E4DCCB" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D8CDB6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#B5AFA3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Fill" Value="#DDD7CB" />
            <Setter Property="Margin" Value="7,7" />
        </Style>

        <!-- Baum: Ordner einzeilig, Dateien zweizeilig (Überschrift, Dateiname) -->
        <HierarchicalDataTemplate DataType="{x:Type local:FolderNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="12.5"
                       FontWeight="SemiBold" Foreground="#4A473F"
                       Margin="0,4,0,4" TextTrimming="CharacterEllipsis" />
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type local:FileNode}">
            <StackPanel Margin="0,5,0,5">
                <TextBlock Text="{Binding Display}" FontFamily="Georgia, Cambria, Segoe UI"
                           FontSize="13" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#2B2A26" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Heading}" Value="{x:Null}">
                                    <Setter Property="Foreground" Value="#B5AFA3" />
                                    <Setter Property="FontStyle" Value="Italic" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="10.5"
                           Foreground="#9A958B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:LoadingNode}">
            <TextBlock Text="{Binding Name}" FontFamily="Segoe UI" FontSize="11.5"
                       FontStyle="Italic" Foreground="#B5AFA3" Margin="0,3,0,3" />
        </DataTemplate>

        <Style x:Key="TreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Padding" Value="2,0" />
            <Setter Property="Foreground" Value="#2B2A26" />
        </Style>

    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="ApplicationCommands.New" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="ApplicationCommands.Open" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.OpenFolderCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="ApplicationCommands.Save" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="ApplicationCommands.SaveAs" />
        <KeyBinding Key="S" Modifiers="Ctrl+Alt" Command="{x:Static local:MainWindow.SaveVersionCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="ApplicationCommands.Find" />
        <KeyBinding Key="H" Modifiers="Ctrl" Command="ApplicationCommands.Replace" />
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.RefreshTreeCommand}" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.New" Executed="OnNew" />
        <CommandBinding Command="ApplicationCommands.Open" Executed="OnOpen" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="OnSave" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="OnSaveAs" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFind" />
        <CommandBinding Command="ApplicationCommands.Replace" Executed="OnReplace" />
        <CommandBinding Command="{x:Static local:MainWindow.OpenFolderCommand}" Executed="OnOpenFolder" />
        <CommandBinding Command="{x:Static local:MainWindow.SaveVersionCommand}" Executed="OnSaveVersion" />
        <CommandBinding Command="{x:Static local:MainWindow.RefreshTreeCommand}" Executed="OnRefreshTree" />
    </Window.CommandBindings>

    <DockPanel>

        <Menu DockPanel.Dock="Top" Style="{StaticResource Chrome}">
            <MenuItem Header="_Datei">
                <MenuItem Header="_Neu"              Command="ApplicationCommands.New"    InputGestureText="Strg+N" />
                <MenuItem Header="Datei ö_ffnen…"    Command="ApplicationCommands.Open"   InputGestureText="Strg+O" />
                <MenuItem Header="_Basisverzeichnis öffnen…" Command="{x:Static local:MainWindow.OpenFolderCommand}" InputGestureText="Strg+Umschalt+O" />
                <Separator />
                <MenuItem Header="_Speichern"        Command="ApplicationCommands.Save"   InputGestureText="Strg+S" />
                <MenuItem Header="Speichern _unter…" Command="ApplicationCommands.SaveAs" InputGestureText="Strg+Umschalt+S" />
                <MenuItem Header="Als neue _Version sichern" Command="{x:Static local:MainWindow.SaveVersionCommand}" InputGestureText="Strg+Alt+S" />
                <Separator />
                <MenuItem Header="_Beenden" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Bearbeiten">
                <MenuItem Header="_Rückgängig"  Command="ApplicationCommands.Undo" InputGestureText="Strg+Z" />
                <MenuItem Header="_Wiederholen" Command="ApplicationCommands.Redo" InputGestureText="Strg+Y" />
                <Separator />
                <MenuItem Header="_Suchen…"   Command="ApplicationCommands.Find"    InputGestureText="Strg+F" />
                <MenuItem Header="_Ersetzen…" Command="ApplicationCommands.Replace" InputGestureText="Strg+H" />
            </MenuItem>
            <MenuItem Header="_Ansicht">
                <MenuItem Header="Navigation _aktualisieren" Command="{x:Static local:MainWindow.RefreshTreeCommand}" InputGestureText="F5" />
                <MenuItem x:Name="MenuShowTree" Header="Navigation an_zeigen" IsCheckable="True" IsChecked="True" Click="OnToggleTree" />
                <Separator />
                <MenuItem x:Name="MenuAutoSave" Header="Auto_speichern (Absturzsicherung)" IsCheckable="True" IsChecked="True" Click="OnToggleAutoSave" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Background="#F1EEE8" BorderBrush="#E3DED4" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal" Margin="6,4">
                <Button Style="{StaticResource ToolButton}" Content="Ordner…"
                        Command="{x:Static local:MainWindow.OpenFolderCommand}"
                        ToolTip="Basisverzeichnis für die Navigation wählen (Strg+Umschalt+O)" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Content="Neu"
                        Command="ApplicationCommands.New" ToolTip="Neues Dokument (Strg+N)" />
                <Button Style="{StaticResource ToolButton}" Content="Öffnen…"
                        Command="ApplicationCommands.Open" ToolTip="Einzelne Datei öffnen (Strg+O)" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button x:Name="ButtonSave" Style="{StaticResource ToolButton}" Content="Speichern"
                        Command="ApplicationCommands.Save" ToolTip="Datei speichern (Strg+S)" />
                <Button x:Name="ButtonVersion" Style="{StaticResource ToolButton}" Content="Version sichern"
                        Command="{x:Static local:MainWindow.SaveVersionCommand}"
                        ToolTip="Nummerierte Kopie in .versions ablegen (Strg+Alt+S)" />
                <Rectangle Style="{StaticResource ToolSeparator}" />
                <Button Style="{StaticResource ToolButton}" Content="Suchen"
                        Command="ApplicationCommands.Find" ToolTip="Suchen und Ersetzen (Strg+F)" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#F1EEE8" BorderBrush="#E3DED4" BorderThickness="0,1,0,0">
            <Grid Margin="14,4">
                <TextBlock x:Name="StatusFile" HorizontalAlignment="Left"
                           FontFamily="Segoe UI" FontSize="11.5" Foreground="#8A857B" Text="Unbenannt" />
                <TextBlock x:Name="StatusMessage" HorizontalAlignment="Center"
                           FontFamily="Segoe UI" FontSize="11.5" Foreground="#5F7F4F" Text="" />
                <TextBlock x:Name="StatusCount" HorizontalAlignment="Right"
                           FontFamily="Segoe UI" FontSize="11.5" Foreground="#8A857B" Text="0 Wörter" />
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" x:Name="TreePanel" Background="#F7F4EE"
                    BorderBrush="#E3DED4" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,8,8,8" BorderBrush="#E3DED4" BorderThickness="0,0,0,1">
                        <TextBlock x:Name="TreeHeader" Text="Kein Basisverzeichnis"
                                   FontFamily="Segoe UI" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="#8A857B" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <TreeView x:Name="Tree" Background="Transparent" BorderThickness="0"
                              Padding="6,4,4,10"
                              ItemContainerStyle="{StaticResource TreeItem}"
                              SelectedItemChanged="OnTreeSelectionChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="TreeSplitter" Width="5" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"
                          ResizeBehavior="PreviousAndNext" />

            <RichTextBox Grid.Column="2" x:Name="Editor"
                         BorderThickness="0"
                         Background="#FDFCFA"
                         Padding="0"
                         AcceptsTab="True"
                         SpellCheck.IsEnabled="False"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         SelectionBrush="#CFE0F0"
                         CaretBrush="#33322E"
                         TextChanged="OnTextChanged"
                         SizeChanged="OnEditorSizeChanged"
                         PreviewKeyDown="OnEditorPreviewKeyDown" />
        </Grid>

    </DockPanel>
</Window>
