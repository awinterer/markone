<Window x:Class="MarkOne.FindReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suchen und Ersetzen"
        Height="Auto" Width="430" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Chrome}"
        FontFamily="{DynamicResource Font.Ui}" FontSize="12.5">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="ApplicationCommands.Close" />
        <KeyBinding Key="Return" Command="ApplicationCommands.Find" />
    </Window.InputBindings>

    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Close" Executed="OnCloseCmd" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindNextCmd" />
    </Window.CommandBindings>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Suchen" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox   Grid.Row="0" Grid.Column="1" x:Name="FindBox" Margin="0,0,0,8" Padding="4,3" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Ersetzen" VerticalAlignment="Center" Margin="0,0,10,8" />
        <TextBox   Grid.Row="1" Grid.Column="1" x:Name="ReplaceBox" Margin="0,0,0,8" Padding="4,3" />

        <CheckBox Grid.Row="2" Grid.Column="1" x:Name="MatchCase"
                  Content="Groß-/Kleinschreibung beachten" Margin="0,2,0,12" />

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Weitersuchen"  Click="OnFindNext"   Padding="12,5" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="Ersetzen"      Click="OnReplaceOne" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Alle ersetzen" Click="OnReplaceAll" Padding="12,5" />
        </StackPanel>

        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="Info"
                   Foreground="{DynamicResource Brush.Muted}" Margin="0,10,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
