<Window x:Class="MarkOne.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nicht gespeicherte Fassungen"
        Width="660" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#F1EEE8"
        FontFamily="Segoe UI" FontSize="12.5">

    <StackPanel Margin="20">

        <TextBlock TextWrapping="Wrap" Foreground="#3B382F" Margin="0,0,0,4">
            MarkOne wurde beim letzten Mal beendet, ohne dass diese Änderungen gespeichert wurden.
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Foreground="#8A857B" FontSize="11.5" Margin="0,0,0,14">
            Die Originaldateien sind unverändert. Beim Wiederherstellen wird der gesicherte Stand
            geöffnet, aber noch nicht geschrieben — du entscheidest danach selbst über das Speichern.
        </TextBlock>

        <ListBox x:Name="Entries" Height="190" BorderBrush="#DDD7CB" Background="#FDFCFA"
                 SelectionMode="Single" Margin="0,0,0,16">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,6">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="#2B2A26" />
                        <TextBlock Text="{Binding DisplayDetail}" FontSize="11" Foreground="#8A857B"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Wiederherstellen" Click="OnRestore" Padding="14,6" Margin="0,0,8,0" IsDefault="True" />
            <Button Content="Verwerfen"        Click="OnDiscard" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Später"           Click="OnLater"   Padding="14,6" IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
